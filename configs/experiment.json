{
  "project": {
    "name": "edge-cloud-power-estimation-digital-twin",
    "claim_scope": "simulation-based evaluation calibrated from one real sensor trace",
    "power_definition": "apparent_power_va_reported_as_w_by_legacy_firmware"
  },
  "data": {
    "reference_trace": "Data/sensor_data_export_2026-05-17_to_2026-05-23.xlsx",
    "augmented_legacy": "Data/sensor_data.csv",
    "output_dir": "outputs",
    "start_time_utc": "2026-06-01T00:00:00Z",
    "sample_interval_seconds": 3.5,
    "duration_hours": 24,
    "runs_per_scenario": 4,
    "base_seed": 20260728
  },
  "scenarios": [
    {
      "id": "normal",
      "role": "train",
      "outdoor_temperature_offset_c": 0.0,
      "humidity_offset_pct": 0.0,
      "occupancy_scale": 1.0,
      "load_scale": 1.0,
      "packet_loss_scale": 1.0,
      "sensor_dropout_scale": 1.0
    },
    {
      "id": "hot_busy",
      "role": "train",
      "outdoor_temperature_offset_c": 3.0,
      "humidity_offset_pct": 2.0,
      "occupancy_scale": 1.7,
      "load_scale": 1.25,
      "packet_loss_scale": 1.0,
      "sensor_dropout_scale": 1.0
    },
    {
      "id": "humid_unstable",
      "role": "validation",
      "outdoor_temperature_offset_c": 1.0,
      "humidity_offset_pct": 10.0,
      "occupancy_scale": 1.2,
      "load_scale": 1.1,
      "packet_loss_scale": 2.5,
      "sensor_dropout_scale": 1.5
    },
    {
      "id": "sensor_degraded",
      "role": "test",
      "outdoor_temperature_offset_c": 0.5,
      "humidity_offset_pct": 4.0,
      "occupancy_scale": 1.1,
      "load_scale": 1.05,
      "packet_loss_scale": 8.0,
      "sensor_dropout_scale": 3.0
    },
    {
      "id": "cool_low_load",
      "role": "test",
      "outdoor_temperature_offset_c": -2.0,
      "humidity_offset_pct": -5.0,
      "occupancy_scale": 0.6,
      "load_scale": 0.85,
      "packet_loss_scale": 1.0,
      "sensor_dropout_scale": 1.0
    }
  ],
  "model": {
    "train_scenarios": ["normal", "hot_busy"],
    "validation_scenarios": ["humid_unstable"],
    "test_scenarios": ["sensor_degraded", "cool_low_load"],
    "random_forest_trees": 120,
    "random_state": 20260728
  },
  "benchmark": {
    "sample_size": 5000,
    "workload": {
      "source": "legacy_augmented_replay",
      "expected_rows": 2027520,
      "reference_rows_per_replay": 92160,
      "sampling": "evenly spaced across all replay blocks",
      "purpose": "architecture latency, throughput, routing, and Web-3D replay only; never model accuracy"
    },
    "cloud_routing": {
      "power_anomaly_threshold_w": 42.6,
      "basis": "p99 legacy power in the real calibration trace; invalid electrical readings are also routed to cloud"
    },
    "cloud_network_profile": {
      "label": "configured network emulation; not a measured public cloud",
      "median_ms": 45.0,
      "jitter_ms": 12.0,
      "drop_probability": 0.005
    }
  }
}
