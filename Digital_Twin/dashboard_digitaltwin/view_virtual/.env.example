# Konfigurasi dashboard replay historis.
# Nilai bawaan menunjuk ke `python -m src.replay.replay_server`.
VITE_TELEMETRY_API_URL=http://127.0.0.1:8000/api

# Interval permintaan payload berikutnya. Ini mengatur kecepatan presentasi
# replay, bukan interval pengukuran asli.
VITE_TELEMETRY_POLL_INTERVAL_MS=3500
